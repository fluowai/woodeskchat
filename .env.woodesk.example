# =============================================================================
# Woodesk — env de produção para o stack Portainer
# (docker-compose.woodesk.yaml). Banco de dados EXTERNO (com pgvector), Redis
# local por padrão. Copie para `.env.woodesk` (ao lado do compose) e preencha
# todos os valores. NUNCA comite `.env.woodesk`.
# =============================================================================

## ---- Identidade do app ----
# Origem HTTPS pública da instalação (usada em e-mails, redirects e widget).
FRONTEND_URL=https://woodesk.exemplo.com.br

## ---- Caddy (TLS + reverse proxy) ----
# Domínio público do Woodesk (Caddy usa para Let's Encrypt ACME).
CADDY_DOMAIN=woodesk.exemplo.com.br
# Email para notificações Let's Encrypt.
CADDY_EMAIL=admin@woodesk.exemplo.com.br
# Host/porta internos do Puma (nome do service no compose).
CADDY_RAILS_HOST=rails
CADDY_RAILS_PORT=3000

## ---- Rails / segredos ----
# Gerado via `bundle exec rails secret` ou `node -e "require('crypto').randomBytes(64).toString('hex')"`.
SECRET_KEY_BASE=f45383c144cb73c534730263aba9e41f7aa881f33136b2e9a27c7f77916d4ee2d052ece792487ef7ec13306c6ff6b6aaeb30646ca5a6214b4d3b727883bf93ae

# Chaves de Active Record Encryption (obrigatórias p/ MFA/2FA).
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=cfb1f114196f717b4dc7a4e142aecfd3e331c14e2e42202f11f2f4aee427b21e
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=db13cde7485c0a4cd96ad085a6a5361b190fcca3926b5f4ed0666df2f9201bf8
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=ba6fc660137ddd18fd0b56b50962838dad5b84fa7f894fc423c4a36be5a29662

# Travar em produção.
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

# Assets estáticos servidos pelo Rails (embutidos na imagem em build time).
RAILS_SERVE_STATIC_FILES=true
# TLS é terminado pelo Caddy (reverse proxy). Manter FORCE_SSL=false para que o
# healthcheck interno (/health em http://127.0.0.1:3000) responda 200 e os
# cookies seguros funcionem via X-Forwarded-Proto (trusted_proxies RFC1918).
FORCE_SSL=false
LOG_LEVEL=info

## ---- Puma / concorrência ----
# Threads baixas se o banco externo limitar conexões (Supabase free: 20).
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5
RAILS_MIN_THREADS=5
RAILS_TIMEOUT=25

## ---- PostgreSQL EXTERNO (obrigatório) ----
# Ex.: Supabase pooler, RDS com pgvector, Neon. O DB precisa das extensões:
#   create extension if not exists "pg_stat_statements";
#   create extension if not exists "pg_trgm";
#   create extension if not exists "pgcrypto";
#   create extension if not exists vector;
POSTGRES_HOST=<DB_HOST>
POSTGRES_PORT=5432
POSTGRES_USERNAME=<DB_USER>
POSTGRES_PASSWORD=<DB_PASSWORD>
POSTGRES_DATABASE=woodesk_production
# Habilite para banco que exige SSL (Supabase/Neon).
POSTGRES_SSL=true

## ---- Redis ----
# Com o serviço redis do stack local, use: redis://redis:6379 (REDIS_PASSWORD abaixo).
# Para Redis gerenciado (ex.: Upstash), aponte aqui e remova o serviço redis do compose.
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=replace_with_a_strong_password_for_redis
# Se REDIS_URL já embute a senha (ex.: rediss://default:<TOKEN>@...), deixe REDIS_PASSWORD vazio
# apenas quando o serviço redis do compose for removido; com o serviço local, mantenha-o igual
# ao valor usado no container.

## ---- E-mail (SMTP) ----
MAILER_SENDER_EMAIL=Woodesk <noreply@woodesk.exemplo.com.br>
SMTP_DOMAIN=woodesk.exemplo.com.br
SMTP_ADDRESS=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=SG.xxxxx
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

## ---- Storage (S3 recomendado — armazenamento local não escala entre containers) ----
ACTIVE_STORAGE_SERVICE=amazon
S3_BUCKET_NAME=woodesk-production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

## ---- Webhooks (canais sociais) ----
# O FRONTEND_URL público deve estar acessível para webhooks de entrada.
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
IG_VERIFY_TOKEN=
TWITTER_APP_ID=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ENVIRONMENT=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_KEY=

## ---- Push (widget/dashboard) ----
# GERAR via https://d3v.one/vapid-key-generator/
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# p/ apps mobile:
# FCM_SERVER_KEY=

## ---- Hub Woodesk (telemetria/registro de instância) ----
# Default: https://hub.2.woodesk.com — sobrescreva quando hospedar um hub próprio.
# WOODESK_HUB_URL=https://hub.example.com

## ---- Busca avançada (OpenSearch) ----
# OPENSEARCH_URL=https://opensearch:9200

## ---- Monitoramento / APM (opcional) ----
SENTRY_DSN=
# ELASTIC_APM_SERVER_URL=, ELASTIC_APM_SECRET_TOKEN=
# DD_TRACE_AGENT_URL=
# SCOUT_KEY=

## ---- IP lookup (GeoIP) ----
IP_LOOKUP_API_KEY=

## ---- Override da imagem (build local) ----
# WOODESK_IMAGE=woodesk/chat:latest

## ---- Controle de cadastro ----
# true (padrão): permite cadastro público | false: desativa | api_only: apenas API
ENABLE_ACCOUNT_SIGNUP=false