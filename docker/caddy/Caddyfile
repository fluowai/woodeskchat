# Caddyfile — Reverse proxy with automatic HTTPS (Let's Encrypt).
# Env vars substituted by docker-compose: CADDY_DOMAIN, CADDY_EMAIL.

{
    # Global notification email used for ACME certificate issuance / renewal.
    email {$CADDY_EMAIL}
    # Production-grade logging to stdout (container-collected).
    log {
        output stdout
        format console
    }
}

{$CADDY_DOMAIN} {
    # Security headers — CSP is served by Rails (nonce-aware, dynamic).
    # Caddy adds transport/security headers only; no Content-Security-Policy here.
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    encode gzip

    # ActionCable WebSocket endpoint (Caddy 2 upgrades websockets automatically).
    reverse_proxy /cable {$CADDY_RAILS_HOST}:{$CADDY_RAILS_PORT}

    # Precompiled assets (served by Rails in the image via RAILS_SERVE_STATIC_FILES=true;
    # proxied here. Fase B: mount a shared assets volume so Caddy serves them directly).
    reverse_proxy /packs/* {$CADDY_RAILS_HOST}:{$CADDY_RAILS_PORT}
    reverse_proxy /assets/* {$CADDY_RAILS_HOST}:{$CADDY_RAILS_PORT}
    reverse_proxy /vite/* {$CADDY_RAILS_HOST}:{$CADDY_RAILS_PORT}

    # Everything else -> Rails (API, dashboard, widget).
    reverse_proxy {$CADDY_RAILS_HOST}:{$CADDY_RAILS_PORT}
}
