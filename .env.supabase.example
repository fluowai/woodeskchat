# =============================================================================
# Woodesk — Production env for the Supabase stack
# (docker-compose.supabase.yaml). No DB/Redis containers are used here;
# PostgreSQL is Supabase (managed) and Redis is Upstash (serverless managed).
# Copy to `.env.supabase` and fill every value. NEVER commit `.env.supabase`.
# =============================================================================

## ---- App identity ----
# Public HTTPS origin of this installation (used in emails, redirects, widget).
FRONTEND_URL=https://woodesk.exemplo.com.br

## ---- Rails / secrets ----
# Generated via `bundle exec rails secret`. Alfanumérico, >= 60 chars.
SECRET_KEY_BASE=replace_with_lengthy_secure_hex_from_rails_secret

# Active Record Encryption keys (REQUIRED for MFA/2FA). Generate via:
#   bundle exec rails db:encryption:init   -> copy the three values below.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Lock to production.
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

# Serve static assets from the container (baked into the image at build time).
RAILS_SERVE_STATIC_FILES=true
# Force HTTPS redirects + secure cookies.
FORCE_SSL=true
LOG_LEVEL=info

## ---- Puma / concurrency ----
# Keep threads LOW (Supabase free tier caps connections at 20).
# Use the Supabase connection *pooler* (DATABASE_URL below) for pgbouncer.
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5
RAILS_MIN_THREADS=5
RAILS_TIMEOUT=25

## ---- PostgreSQL / Supabase ----
# Supabase pooler endpoint (recommended). Get from Supabase > Project Settings > Database.
# Format: postgres://postgres.<PROJECT_REF>:<DB_PASSWORD>@<PROJECT_REF>-pooler.supabase.co:5432/postgres
DATABASE_URL=postgres://postgres.<PROJECT_REF>:<DB_PASSWORD>@<PROJECT_REF>-pooler.supabase.co:5432/postgres

# Individual vars also consumed by config/database.yml (derived from DATABASE_URL above).
POSTGRES_HOST=<PROJECT_REF>-pooler.supabase.co
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres.<PROJECT_REF>
POSTGRES_PASSWORD=<DB_PASSWORD>
POSTGRES_DATABASE=postgres
# Supabase requires SSL.
POSTGRES_SSL=true
# pgvector extension is enabled in Supabase; no extra flag needed.
# Ensure these Supabase extensions are available (SQL editor):
#   create extension if not exists "pg_stat_statements";
#   create extension if not exists "pg_trgm";
#   create extension if not exists "pgcrypto";
#   create extension if not exists vector;

## ---- Redis (Upstash) ----
# Upstash Redis (serverless). Supabase does NOT provide Redis.
# Create at Upstash > Redis > Create; use the REDIS_URL / rediss:// endpoint.
REDIS_URL=rediss://default:<UPTASH_TOKEN>@<UPSTASH_ENDPOINT>.upstash.io

# Redis password (Upstash token). Keep empty if token is embedded in REDIS_URL.
REDIS_PASSWORD=

## ---- Email (SMTP) ----
MAILER_SENDER_EMAIL=Woodesk <noreply@woodesk.exemplo.com.br>
SMTP_DOMAIN=woodesk.exemplo.com.br
SMTP_ADDRESS=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=SG.xxxxx
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

## ---- Storage (RECOMMENDED S3 — local storage does not scale across containers) ----
ACTIVE_STORAGE_SERVICE=amazon
S3_BUCKET_NAME=woodesk-production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

## ---- Webhooks (social channels) ----
# Public HTTPS URL must be reachable for inbound webhooks (Facebook/WhatsApp/etc).
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
TWITTER_APP_ID=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ENVIRONMENT=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_KEY=

## ---- Optional: advanced search (OpenSearch) ----
# If enabling advanced search, deploy an OpenSearch container/service and set:
# OPENSEARCH_URL=https://opensearch:9200
# ELASTICSEARCH_API_KEY=

## ---- Optional: monitoring / APM ----
SENTRY_DSN=
# ELASTIC_APM_SERVER_URL=, ELASTIC_APM_SECRET_TOKEN=
# DD_TRACE_AGENT_URL=
# SCOUT_KEY=, SCOUT_MONITOR=true

## ---- Optional: IP lookup (GeoIP) ----
IP_LOOKUP_API_KEY=

## ---- Caddy TLS (Let's Encrypt auto-provisioning) ----
# Domain for the public endpoint (CNAME/A must point to this host on :80/:443).
CADDY_DOMAIN=woodesk.exemplo.com.br
# Email used for ACME cert issuance/renewal notifications.
CADDY_EMAIL=admin@woodesk.exemplo.com.br

## ---- Image override (build locally) ----
# WOODESK_IMAGE can point to your own built tag, e.g. woodesk:4.16.2-prod
WOODESK_IMAGE=woodesk/chat:latest

## ---- Account signup control ----
# true (default): allow public sign-ups | false: disable | api_only: API-only
ENABLE_ACCOUNT_SIGNUP=false
